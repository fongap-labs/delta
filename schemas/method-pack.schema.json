{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://delta.foundation/schemas/method-pack.schema.json",
  "title": "Analysis method pack",
  "description": "A versioned set of analysis methods with a fixed environment and validation evidence (ADR-0079, ADR-0080). A validated method pack is the only source of numbers that may enter a formal report under the validated assurance level.",
  "type": "object",
  "required": [
    "format",
    "version",
    "id",
    "pack_version",
    "assurance",
    "engine",
    "environment",
    "methods"
  ],
  "additionalProperties": false,
  "properties": {
    "format": {
      "const": "delta.method-pack"
    },
    "version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "pack_version": {
      "type": "string",
      "minLength": 1
    },
    "assurance": {
      "enum": [
        "validated",
        "attested"
      ]
    },
    "engine": {
      "enum": [
        "python",
        "r",
        "external"
      ]
    },
    "environment": {
      "type": "object",
      "required": [
        "environment_sha256"
      ],
      "additionalProperties": false,
      "properties": {
        "environment_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "lockfile": {
          "type": "string",
          "minLength": 1
        },
        "engine_version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "methods": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/method"
      }
    },
    "validation": {
      "$ref": "#/definitions/validation"
    },
    "signature": {
      "type": "object",
      "required": [
        "key_id",
        "value"
      ],
      "additionalProperties": false,
      "properties": {
        "key_id": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "assurance": {
            "enum": [
              "validated",
              "attested"
            ]
          }
        },
        "required": [
          "assurance"
        ]
      },
      "then": {
        "required": [
          "validation"
        ]
      }
    }
  ],
  "definitions": {
    "method": {
      "type": "object",
      "required": [
        "id",
        "version",
        "capability_id",
        "description",
        "parameters_schema"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "capability_id": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "parameters_schema": {
          "type": "object"
        },
        "report_templates": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "validation": {
      "type": "object",
      "required": [
        "report_id",
        "scope",
        "issued_at"
      ],
      "additionalProperties": false,
      "properties": {
        "report_id": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "issued_at": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
