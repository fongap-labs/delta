{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://delta.foundation/schemas/study.schema.json",
  "title": "Study record",
  "description": "A multi-round study's design and decisions (ADR-0056). The locked fields (objective, responses, allowed_adjustments, stopping_rule, analysis_plan) change only through study.amend. Domain fields go under extensions.",
  "type": "object",
  "required": ["schema_version", "objective", "responses", "factors", "allowed_adjustments", "stopping_rule", "analysis_plan"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": 1},
    "objective": {"type": "string", "minLength": 1},
    "responses": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "criterion"],
        "additionalProperties": false,
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "criterion": {"type": "string", "minLength": 1}
        }
      }
    },
    "factors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "low", "high"],
        "additionalProperties": false,
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "low": {"type": "number"},
          "high": {"type": "number"}
        }
      }
    },
    "allowed_adjustments": {
      "type": "object",
      "required": ["factors"],
      "additionalProperties": false,
      "properties": {
        "factors": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "min", "max"],
            "additionalProperties": false,
            "properties": {
              "name": {"type": "string", "minLength": 1},
              "min": {"type": "number"},
              "max": {"type": "number"}
            }
          }
        },
        "may_add": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "stopping_rule": {"type": "string", "minLength": 1},
    "analysis_plan": {
      "type": "object",
      "required": ["model", "significance_level", "confidence_level"],
      "additionalProperties": false,
      "properties": {
        "model": {"type": "string", "minLength": 1},
        "significance_level": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1},
        "confidence_level": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1}
      }
    },
    "rounds": {"type": "array", "items": {"type": "object"}},
    "decisions": {"type": "array", "items": {"type": "object"}},
    "recommendations": {"type": "array", "items": {"type": "object"}},
    "extensions": {"type": "object"}
  }
}
