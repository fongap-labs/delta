{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://delta.foundation/schemas/study.schema.json",
  "title": "Study record",
  "description": "A multi-round study's design and decisions (ADR-0056). The locked fields (objective, responses, allowed_adjustments, stopping_rule, analysis_plan, sequential) change only through study.amend. Domain fields go under extensions. `sequential` is the stopping rule in a form a program can evaluate; `interim` is derived from it and the rounds and is refused when it disagrees with them.",
  "type": "object",
  "required": [
    "schema_version",
    "objective",
    "responses",
    "factors",
    "allowed_adjustments",
    "stopping_rule",
    "analysis_plan"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "responses": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name",
          "criterion"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "criterion": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "factors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "low",
          "high"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "low": {
            "type": "number"
          },
          "high": {
            "type": "number"
          }
        }
      }
    },
    "allowed_adjustments": {
      "type": "object",
      "required": [
        "factors"
      ],
      "additionalProperties": false,
      "properties": {
        "factors": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "min",
              "max"
            ],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "min": {
                "type": "number"
              },
              "max": {
                "type": "number"
              }
            }
          }
        },
        "may_add": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "stopping_rule": {
      "type": "string",
      "minLength": 1
    },
    "analysis_plan": {
      "type": "object",
      "required": [
        "model",
        "significance_level",
        "confidence_level"
      ],
      "additionalProperties": false,
      "properties": {
        "model": {
          "type": "string",
          "minLength": 1
        },
        "significance_level": {
          "type": "number",
          "exclusiveMinimum": 0,
          "exclusiveMaximum": 1
        },
        "confidence_level": {
          "type": "number",
          "exclusiveMinimum": 0,
          "exclusiveMaximum": 1
        }
      }
    },
    "rounds": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/round"
      },
      "description": "Free-form unless the study has a sequential rule; then each round must match the round definition."
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "recommendations": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "extensions": {
      "type": "object"
    },
    "sequential": {
      "type": "object",
      "required": [
        "rule"
      ],
      "additionalProperties": false,
      "properties": {
        "rule": {
          "type": "object",
          "required": [
            "response",
            "direction",
            "threshold",
            "consecutive_rounds",
            "max_rounds"
          ],
          "additionalProperties": false,
          "properties": {
            "response": {
              "type": "string",
              "minLength": 1
            },
            "direction": {
              "enum": [
                "at_least",
                "at_most"
              ]
            },
            "threshold": {
              "type": "number"
            },
            "basis": {
              "enum": [
                "estimate",
                "conservative_bound"
              ],
              "default": "estimate"
            },
            "consecutive_rounds": {
              "type": "integer",
              "minimum": 1
            },
            "max_rounds": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      }
    },
    "interim": {
      "type": "object",
      "required": [
        "rounds_analysed",
        "status"
      ],
      "additionalProperties": false,
      "properties": {
        "rounds_analysed": {
          "type": "integer",
          "minimum": 0
        },
        "status": {
          "enum": [
            "continue",
            "stopped_met",
            "stopped_exhausted"
          ]
        }
      }
    }
  },
  "definitions": {
    "source": {
      "type": "object",
      "required": [
        "artifact",
        "sha256",
        "key"
      ],
      "additionalProperties": false,
      "properties": {
        "artifact": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "key": {
          "type": "string",
          "minLength": 1
        },
        "ci_lower_key": {
          "type": "string",
          "minLength": 1
        },
        "ci_upper_key": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "response_result": {
      "type": "object",
      "required": [
        "value",
        "source"
      ],
      "additionalProperties": false,
      "properties": {
        "value": {
          "type": "number"
        },
        "ci_lower": {
          "type": "number"
        },
        "ci_upper": {
          "type": "number"
        },
        "source": {
          "$ref": "#/definitions/source"
        }
      }
    },
    "round": {
      "type": "object",
      "required": [
        "number",
        "factors"
      ],
      "properties": {
        "number": {
          "type": "integer",
          "minimum": 1
        },
        "factors": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "low",
              "high"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "low": {
                "type": "number"
              },
              "high": {
                "type": "number"
              }
            }
          }
        },
        "results": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/response_result"
          }
        },
        "best_point": {
          "type": "object",
          "additionalProperties": {
            "type": "number"
          }
        }
      }
    }
  }
}
