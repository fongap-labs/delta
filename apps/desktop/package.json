{
  "name": "@deepseek-ai/dsh-desktop",
  "description": "Delta portable desktop shell and bundled runtime",
  "version": "0.2.3-alpha.2",
  "private": true,
  "license": "MIT",
  "author": {
    "name": "Hangzhou DeepSeek Artificial Intelligence Co., Ltd."
  },
  "type": "module",
  "main": "lib/main.js",
  "scripts": {
    "test:installer": "node scripts/test-windows-installer.mjs",
    "build": "tsc -b && pnpm run bundle",
    "bundle": "tsdown --config-loader native",
    "dev": "tsx scripts/dev.ts",
    "start": "tsx scripts/dev.ts --skip-build",
    "test:updates:channels": "pnpm run build && node scripts/test-update-channels.mjs",
    "test:updates:local": "pnpm run build && node scripts/test-local-updater.mjs",
    "prepare:runtime": "tsx scripts/prepare-runtime.ts",
    "render:tray-icon": "tsx scripts/render-tray-icon.ts",
    "prepare:primary-runtime": "tsx scripts/prepare-primary-runtime.ts",
    "sign:primary-runtime": "tsx scripts/sign-primary-runtime.ts",
    "cache:windows-signatures": "node scripts/manage-windows-signature-cache.mjs",
    "prepare:packages": "tsx scripts/prepare-package-set.ts",
    "prepare:dsh": "tsx scripts/prepare-dsh.ts",
    "package:delta-portable": "node scripts/package-delta-portable.mjs",
    "package:win:x64": "node scripts/package-delta-portable.mjs"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "semver": "^7.8.5",
    "ws": "^8.21.3",
    "@deepseek-ai/dsh-api-gateway": "workspace:*",
    "@deepseek-ai/dsh-error": "workspace:*",
    "@deepseek-ai/cordis": "workspace:~"
