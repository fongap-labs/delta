* text=auto
*.sh text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.py text eol=lf
*.rs text eol=lf
*.toml text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.mjs text eol=lf

# Exclude test code from GitHub Linguist language statistics.
tests/** linguist-detectable=false
test/** linguist-detectable=false
**/tests/** linguist-detectable=false
**/test/** linguist-detectable=false
**/__tests__/** linguist-detectable=false
**/*-test.* linguist-detectable=false
**/*_test.* linguist-detectable=false
**/*.test.* linguist-detectable=false
**/*.spec.* linguist-detectable=false
**/conftest.py linguist-detectable=false
e2e/** linguist-detectable=false
**/e2e/** linguist-detectable=false
# The changelog only grows, and every change adds its entry at the top of the
# unreleased section. Two changes that are open at the same time therefore touch the
# same lines, and the merge stops with a conflict that has to be resolved by hand.
# Unioning keeps the entries of both sides, which is what an append-only changelog
# wants anyway.
CHANGELOG.md merge=union

# Real Office files used as edit fixtures: never convert line endings.
crates/delta-core/tests/fixtures/office/* binary
