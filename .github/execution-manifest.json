{
  "schema_version": "1",
  "operations": {
    "ci": {
      "jobs": [
        {
          "id": "linux",
          "runner_profile": "linux-standard",
          "command": [
            "node",
            "{target_root}/scripts/delta-verify.mjs",
            "--ci"
          ],
          "timeout_minutes": 15,
          "capability_requests": [
            "source.read"
          ]
        }
      ]
    }
  }
}
